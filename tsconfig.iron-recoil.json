{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "app/iron-recoil/**/*.ts",
    "app/iron-recoil/**/*.tsx",
    "tests/unit/**/*.ts",
    "tests/e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
